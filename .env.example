# ── Required ────────────────────────────────────────────────
# Discord bot token: https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# xAI API key: https://console.x.ai → API Keys
XAI_API_KEY=

# ── Models (change when xAI ships new ones) ─────────────────
GROK_MODEL=grok-4.7
GROK_IMAGE_MODEL=grok-imagine-image-2.0

# ── Spend caps (units per day; a text answer = 1, an image = IMAGE_COST) ──
DAILY_USER_LIMIT=40
DAILY_GUILD_LIMIT=600
IMAGE_COST=5

# ── Optional ────────────────────────────────────────────────
# Register slash commands instantly in one test server (otherwise global sync can take up to an hour)
DEV_GUILD_ID=
# Where settings and usage are stored
DATABASE_PATH=grokcord.db
# Default personality: helper, analyst, roast, teacher, mod, degen
DEFAULT_PERSONA=helper
